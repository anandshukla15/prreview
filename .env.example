# ==============================================================================
# Autonomous Multi-Agent Code Review & Security Auditor Configuration
# ==============================================================================

# Application Configuration
APP_NAME=Autonomous Code Reviewer
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/prreview
DATABASE_SYNC_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/prreview

# Redis (Caching, Locks, Temporary State)
REDIS_URL=redis://localhost:6379/0

# GitHub Integration
GITHUB_TOKEN=ghp_your_github_personal_access_token
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_here

# LLM Provider (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash

# Human-In-The-Loop & Risk Policies
HITL_ENABLED=true
AUTO_PUBLISH_SEVERITY_THRESHOLD=LOW
HIGH_RISK_CONFIDENCE_THRESHOLD=0.90
MIN_CONFIDENCE_THRESHOLD=0.70
